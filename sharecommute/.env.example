# All services run locally. Never commit .env or the data directory.
API_PORT=3001
DATABASE_PATH=data/sharecommute.sqlite
ALLOWED_EMAIL_DOMAINS=mitwpu.edu.in
SEED_SAMPLE_RIDES=true

# All sign-ins require a code delivered to the college email inbox.
# Configure a sender on a verified Resend domain. No local-code fallback exists.
RESEND_API_KEY=
EMAIL_FROM=
