# All services run locally. Never commit .env or the data directory.
API_PORT=3001
DATABASE_PATH=data/sharecommute.sqlite
ALLOWED_EMAIL_DOMAINS=mitwpu.edu.in
SEED_SAMPLE_RIDES=true

# development shows a test code and does NOT verify email ownership.
# Set resend after entering the key and a sender on a verified Resend domain.
MAIL_MODE=development
RESEND_API_KEY=
EMAIL_FROM=
